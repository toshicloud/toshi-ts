{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@toshicloud/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "*.config.ts", "*.config.js"],
  "exclude": ["dist", "node_modules", "coverage"]
}
